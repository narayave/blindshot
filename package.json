{
  "name": "blindshot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && (cp -r public .next/standalone/ 2>/dev/null || true)",
    "start": "next start",
    "lab": "node scripts/film-lab.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "setup": "node --env-file-if-exists=.env.local scripts/setup.ts",
    "event": "node --env-file-if-exists=.env.local scripts/event.ts",
    "reset": "node --env-file-if-exists=.env.local scripts/reset.ts",
    "overlays": "node scripts/overlays.ts",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.ts",
    "watermark": "node scripts/watermark.ts",
    "test": "playwright test",
    "load": "node --env-file-if-exists=.env.local scripts/load.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "opentype.js": "^2.0.0",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": "20.x"
  }
}
